import streamlit as st
import pandas as pd
from pathlib import Path

data_file = Path(__file__).parent / "restaurants.csv"
restaurants = pd.read_csv(data_file)

st.write(restaurants.head())

st.set_page_config(
    page_title="Tokyo Table",
    # page_icon="",
    layout="wide"
)

st.title("Welcome to Tokyo Yelp")
st.write("Find your next favorite restaurant in Tokyo.")

search = st.text_input(
    "What are you looking for?",
    placeholder="Try: sushi near Shibuya"
)

col1, col2, col3 = st.columns(3)

with col1:
    st.selectbox("Cuisine", ["Any", "Ramen", "Sushi", "Izakaya", "Dessert"])

with col2:
    st.selectbox("Neighborhood", ["Any", "Shibuya", "Shinjuku", "Ginza"])

with col3:
    st.selectbox("Budget", ["Any", "¥", "¥¥", "¥¥¥"])

st.subheader("Recommended restaurants")

st.info("Your restaurant recommendations will appear here.")